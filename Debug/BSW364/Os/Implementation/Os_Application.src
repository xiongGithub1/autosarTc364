; ..\BSW364\Os\Implementation\Os_Application.c	  1496   \DESCRIPTION    Write access to the dynamic data of an application. The application pointer is provided as a return
; ..\BSW364\Os\Implementation\Os_Application.c	  1497                   value of Os_ThreadGetCurrentApplication.
; ..\BSW364\Os\Implementation\Os_Application.c	  1498                   CM_OS_THREADGETCURRENTAPPLICATION_N
; ..\BSW364\Os\Implementation\Os_Application.c	  1499   \COUNTERMEASURE \M [CM_OS_APPDYN_M]
