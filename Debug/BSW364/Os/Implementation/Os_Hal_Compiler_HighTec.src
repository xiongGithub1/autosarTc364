; ..\BSW364\Os\Implementation\Os_Hal_Compiler_HighTec.c	    97   *                    D5: current PCXI value
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_HighTec.c	    98   *                    A4: causing address (potential return address)
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_HighTec.c	    99   *                    D6: current Stack memory region lower
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_HighTec.c	   100   *                    D7: current Stack memory region upper
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_HighTec.c	   101   *  \context      EXCEPTION VECTOR
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_HighTec.c	   102   *  \reentrant    FALSE
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_HighTec.c	   103   *  \synchronous  TRUE
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_HighTec.c	   104   *  \pre          -
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_HighTec.c	   105   **********************************************************************************************************************/
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_HighTec.c	   106  OS_FUNC_ATTRIBUTE_DECLARATION(void, OS_CODE, OS_HAL_NOINLINE, Os_Hal_UnhandledExceptionHandler, (void));
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_HighTec.c	   107  OS_FUNC_ATTRIBUTE_DECLARATION(void, OS_CODE, OS_HAL_NOINLINE, Os_Hal_UnhandledExceptionHandler, (void))
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_HighTec.c	   108  {
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_HighTec.c	   109    __asm ("mfcr %d6, " OS_HAL_EXPAND(OS_HAL_COREMPU_DPR_LOW0));      /* prepare parameters for C-Function; D6 = OS_HAL_COREMPU_DPR_LOW0 */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_HighTec.c	   110    __asm ("mfcr %d7, " OS_HAL_EXPAND(OS_HAL_COREMPU_DPR_UPPER0));    /* prepare parameters for C-Function; D7 = OS_HAL_COREMPU_DPR_UPPER0 */
