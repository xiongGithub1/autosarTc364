; ..\BSW364\Os\Implementation\Os_Hal_Compiler_HighTec.c	   114    __asm ("lea %a4,[%a4]lo:OsCfg_Stack_KernelStacks");               /* get address of the correct kernal stack (indexed by core ID); A4 = &OsCfg_Stack_KernelStacks */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_HighTec.c	   115    __asm ("addsc.a %a15,%a4,%d14,2");                                /* choose the correct element out of the array; A15 = &OsCfg_Stack_KernelStacks[Core ID] */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_HighTec.c	   116    __asm ("ld.a %a15,[%a15]");                                       /* get the pointer to the Os_Hal_ContextStackConfigType struct */
