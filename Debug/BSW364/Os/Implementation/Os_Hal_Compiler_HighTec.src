; ..\BSW364\Os\Implementation\Os_Hal_Compiler_HighTec.c	   119    __asm ("ld.w %d12,[%a15]4");                                      /* get the content of Stack.StackRegionEnd;   D12 = Stack.StackRegionEnd */
