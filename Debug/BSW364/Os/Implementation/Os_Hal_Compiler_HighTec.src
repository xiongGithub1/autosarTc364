; ..\BSW364\Os\Implementation\Os_Hal_Compiler_HighTec.c	   119    __asm ("ld.w %d12,[%a15]4");                                      /* get the content of Stack.StackRegionEnd;   D12 = Stack.StackRegionEnd */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_HighTec.c	   120    __asm ("mtcr " OS_HAL_EXPAND(OS_HAL_COREMPU_DPR_UPPER0)", %d12"); /* OS_HAL_COREMPU_DPR_UPPER0 = D12 */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_HighTec.c	   121    __asm ("isync");
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_HighTec.c	   122    __asm ("mov.a %a10, %d12");                                       /* SP = Stack.StackRegionEnd; stack switch */
