; ..\BSW364\Os\Implementation\Os_Trap.c	   182  /*! \brief          Returns whether the current thread is privileged (!0) or not (0).
; ..\BSW364\Os\Implementation\Os_Trap.c	   183   *  \details        Reads the current thread pointer and check the corresponding App's privileges
; ..\BSW364\Os\Implementation\Os_Trap.c	   184   *
; ..\BSW364\Os\Implementation\Os_Trap.c	   185   *  \retval         !0  The current thread is privileged.
