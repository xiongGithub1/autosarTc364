; ..\BSW364\Os\Implementation\Os_Stack.c	  1229                   precondition is check during review.
; ..\BSW364\Os\Implementation\Os_Stack.c	  1230   \COUNTERMEASURE \T [CM_OS_HAL_STACKENDGET_T]
