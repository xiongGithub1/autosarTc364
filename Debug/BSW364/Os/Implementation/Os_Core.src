; ..\BSW364\Os\Implementation\Os_Core.c	  3029   */
; ..\BSW364\Os\Implementation\Os_Core.c	  3030  
; ..\BSW364\Os\Implementation\Os_Core.c	  3031  /*
; ..\BSW364\Os\Implementation\Os_Core.c	  3032   * Review Helper - Naming convention:
; ..\BSW364\Os\Implementation\Os_Core.c	  3033   * Start every justification with SWSW_OS_<Message>_<Name>.
; ..\BSW364\Os\Implementation\Os_Core.c	  3034   * <Message>:
; ..\BSW364\Os\Implementation\Os_Core.c	  3035   *  - AWA: Array write access
; ..\BSW364\Os\Implementation\Os_Core.c	  3036   *  - AI:  Assembler instruction
; ..\BSW364\Os\Implementation\Os_Core.c	  3037   *  - FC:  Function call
; ..\BSW364\Os\Implementation\Os_Core.c	  3038   *  - FPC: Function pointer call
; ..\BSW364\Os\Implementation\Os_Core.c	  3039   *  - PWA: Pointer write access
; ..\BSW364\Os\Implementation\Os_Core.c	  3040   *
; ..\BSW364\Os\Implementation\Os_Core.c	  3041   * <Name>:
; ..\BSW364\Os\Implementation\Os_Core.c	  3042   *  A short name which refers to the justification counter measure.
; ..\BSW364\Os\Implementation\Os_Core.c	  3043   */
; ..\BSW364\Os\Implementation\Os_Core.c	  3044  
; ..\BSW364\Os\Implementation\Os_Core.c	  3045  /* SBSW_JUSTIFICATION_BEGIN
; ..\BSW364\Os\Implementation\Os_Core.c	  3046  
; ..\BSW364\Os\Implementation\Os_Core.c	  3047  \ID SBSW_OS_MEMAP_UNDEF
; ..\BSW364\Os\Implementation\Os_Core.c	  3048   \DESCRIPTION    Undefine of memory start/end section.
; ..\BSW364\Os\Implementation\Os_Core.c	  3049   \COUNTERMEASURE \N No measure required. Undefine is required by AUTOSAR and has no influence on review helper results.
; ..\BSW364\Os\Implementation\Os_Core.c	  3050  
; ..\BSW364\Os\Implementation\Os_Core.c	  3051  \ID SBSW_OS_HAL_EXAMPLE
; ..\BSW364\Os\Implementation\Os_Core.c	  3052   \DESCRIPTION    Function call is used as an example.
; ..\BSW364\Os\Implementation\Os_Core.c	  3053   \COUNTERMEASURE \N No measure required, as the sample call is either replaced by the HAL implementation or justified.
; ..\BSW364\Os\Implementation\Os_Core.c	  3054  
; ..\BSW364\Os\Implementation\Os_Core.c	  3055  \ID SBSW_OS_PWA_LOCAL
; ..\BSW364\Os\Implementation\Os_Core.c	  3056   \DESCRIPTION    Write access to a local array.
; ..\BSW364\Os\Implementation\Os_Core.c	  3057   \COUNTERMEASURE \N No measure required, as the used index is static and in range.
; ..\BSW364\Os\Implementation\Os_Core.c	  3058  
; ..\BSW364\Os\Implementation\Os_Core.c	  3059  
; ..\BSW364\Os\Implementation\Os_Core.c	  3060  \ID SBSW_OS_FC_PRECONDITION_AND_CHECK_IF_NEEDED
; ..\BSW364\Os\Implementation\Os_Core.c	  3061   \DESCRIPTION    The pointer passed to the called function is derived from an argument passed to the caller function.
; ..\BSW364\Os\Implementation\Os_Core.c	  3062                   As the caller of the caller function is enforced by preconditions to pass valid arguments only or
; ..\BSW364\Os\Implementation\Os_Core.c	  3063                   NULL_PTR if allowed by global config, the pointer is correct. Preconditions are checked during code
; ..\BSW364\Os\Implementation\Os_Core.c	  3064                   review.
; ..\BSW364\Os\Implementation\Os_Core.c	  3065   \COUNTERMEASURE \N [CM_OS_PRECONDITION_AND_CHECK_IF_NEEDED_N]
; ..\BSW364\Os\Implementation\Os_Core.c	  3066  
; ..\BSW364\Os\Implementation\Os_Core.c	  3067  \ID SBSW_OS_FC_PRECONDITION_AND_CHECK
; ..\BSW364\Os\Implementation\Os_Core.c	  3068   \DESCRIPTION    The pointer passed to the called function is derived from an argument passed to the caller function.
; ..\BSW364\Os\Implementation\Os_Core.c	  3069                   As the caller of the caller function is enforced by preconditions to pass valid arguments only or
; ..\BSW364\Os\Implementation\Os_Core.c	  3070                   NULL_PTR, the pointer is correct. Preconditions are checked during code review.
; ..\BSW364\Os\Implementation\Os_Core.c	  3071   \COUNTERMEASURE \N [CM_OS_PRECONDITION_AND_CHECK_N]
; ..\BSW364\Os\Implementation\Os_Core.c	  3072  
; ..\BSW364\Os\Implementation\Os_Core.c	  3073  \ID SBSW_OS_PWA_PRECONDITION
; ..\BSW364\Os\Implementation\Os_Core.c	  3074   \DESCRIPTION    Write access to a function argument. Function design requires the caller to pass a valid pointer.
; ..\BSW364\Os\Implementation\Os_Core.c	  3075   \COUNTERMEASURE \N [CM_OS_PRECONDITION_N]
; ..\BSW364\Os\Implementation\Os_Core.c	  3076  
; ..\BSW364\Os\Implementation\Os_Core.c	  3077  \ID SBSW_OS_FC_PRECONDITION
; ..\BSW364\Os\Implementation\Os_Core.c	  3078   \DESCRIPTION    The pointer passed to the called function is derived from an argument passed to the caller function.
; ..\BSW364\Os\Implementation\Os_Core.c	  3079                   As the caller of the caller function is enforced by preconditions or by parameter limitations to pass
; ..\BSW364\Os\Implementation\Os_Core.c	  3080                   valid arguments only, the pointer is correct. Preconditions and parameter limitations are checked
; ..\BSW364\Os\Implementation\Os_Core.c	  3081                   during code review.
; ..\BSW364\Os\Implementation\Os_Core.c	  3082   \COUNTERMEASURE \N None, as the pointer validity is guaranteed.
; ..\BSW364\Os\Implementation\Os_Core.c	  3083  
; ..\BSW364\Os\Implementation\Os_Core.c	  3084  \ID SBSW_OS_PWA_RETURNEDPOINTER
; ..\BSW364\Os\Implementation\Os_Core.c	  3085   \DESCRIPTION    Write access to a pointer returned by a function.
; ..\BSW364\Os\Implementation\Os_Core.c	  3086   \COUNTERMEASURE \N No measure required, as the pointer is returned by a function which returns valid pointer only.
; ..\BSW364\Os\Implementation\Os_Core.c	  3087  
; ..\BSW364\Os\Implementation\Os_Core.c	  3088  \ID SBSW_OS_FC_RETURNEDPOINTER
; ..\BSW364\Os\Implementation\Os_Core.c	  3089   \DESCRIPTION    The passed pointer is derived from a function, which guarantees that the pointer is valid.
; ..\BSW364\Os\Implementation\Os_Core.c	  3090   \COUNTERMEASURE \N No measure required, as the pointer is returned by a function which returns valid pointer only.
; ..\BSW364\Os\Implementation\Os_Core.c	  3091  
; ..\BSW364\Os\Implementation\Os_Core.c	  3092  \ID SBSW_OS_FC_RETURNEDPOINTERWITHCHECK
; ..\BSW364\Os\Implementation\Os_Core.c	  3093   \DESCRIPTION    The passed pointer is derived from a function, which guarantees that the pointer is valid or a
; ..\BSW364\Os\Implementation\Os_Core.c	  3094                   NULL_PTR.
; ..\BSW364\Os\Implementation\Os_Core.c	  3095   \COUNTERMEASURE \N No measure required, as the pointer is returned by a function which returns valid pointer only.
; ..\BSW364\Os\Implementation\Os_Core.c	  3096  
; ..\BSW364\Os\Implementation\Os_Core.c	  3097  \ID SBSW_OS_FC_POINTER2LOCAL
; ..\BSW364\Os\Implementation\Os_Core.c	  3098   \DESCRIPTION    Pass a reference to a local variable.
; ..\BSW364\Os\Implementation\Os_Core.c	  3099   \COUNTERMEASURE \N No measure required, as the passed pointer refers to a local variable and the called function
