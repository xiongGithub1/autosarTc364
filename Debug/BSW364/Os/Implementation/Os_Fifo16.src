; ..\BSW364\Os\Implementation\Os_Fifo16.c	   131  \CM CM_OS_FIFO16READ_DYN_M
; ..\BSW364\Os\Implementation\Os_Fifo16.c	   132        Verify that the Dyn pointer of each Os_Fifo16ReadConfigType object is a non NULL_PTR.
; ..\BSW364\Os\Implementation\Os_Fifo16.c	   133  
; ..\BSW364\Os\Implementation\Os_Fifo16.c	   134  \CM CM_OS_FIFO16WRITE_DYN_M
