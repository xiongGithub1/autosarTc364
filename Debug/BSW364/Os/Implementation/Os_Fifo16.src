; ..\BSW364\Os\Implementation\Os_Fifo16.c	    97  
; ..\BSW364\Os\Implementation\Os_Fifo16.c	    98  \ID SBSW_OS_FF16_FIFOWRITE_DATA_001
; ..\BSW364\Os\Implementation\Os_Fifo16.c	    99   \DESCRIPTION    Write access to the data array of a Fifo16 element. The data array is indexed with
; ..\BSW364\Os\Implementation\Os_Fifo16.c	   100                   a WriteIdx, which is a member of the Fifo's Dyn object.
; ..\BSW364\Os\Implementation\Os_Fifo16.c	   101   \COUNTERMEASURE \T TCASE-345817
; ..\BSW364\Os\Implementation\Os_Fifo16.c	   102                   \M [CM_OS_FIFO16WRITE_DYN_M]
; ..\BSW364\Os\Implementation\Os_Fifo16.c	   103                   \M [CM_OS_FIFO16WRITE_DATA_M]
; ..\BSW364\Os\Implementation\Os_Fifo16.c	   104  
; ..\BSW364\Os\Implementation\Os_Fifo16.c	   105  \ID SBSW_OS_FF16_FIFOIDXINCREMENT_001
; ..\BSW364\Os\Implementation\Os_Fifo16.c	   106   \DESCRIPTION    Os_FifoIdxIncrement is called with a pointer derived from a Dyn pointer. The Dyn pointer is derived
; ..\BSW364\Os\Implementation\Os_Fifo16.c	   107                   from an caller's Fifo argument. The correctness of the Fifo argument is ensured by precondition.
; ..\BSW364\Os\Implementation\Os_Fifo16.c	   108                   The compliance of the precondition is check during review.
; ..\BSW364\Os\Implementation\Os_Fifo16.c	   109   \COUNTERMEASURE \M [CM_OS_FIFO16READ_DYN_M]
; ..\BSW364\Os\Implementation\Os_Fifo16.c	   110  
