; ..\BSW364\Os\Implementation\Os_Error.c	  1727  \ID COV_OS_ERRPARAMLIBFUNCT
; ..\BSW364\Os\Implementation\Os_Error.c	  1728     \ACCEPT XX
; ..\BSW364\Os\Implementation\Os_Error.c	  1729     \REASON This function is a library function. It is meant as an API to retrieve error information of the
; ..\BSW364\Os\Implementation\Os_Error.c	  1730             caller function within the ErrorHook. As the ErrorHook is currently not called from that function,
; ..\BSW364\Os\Implementation\Os_Error.c	  1731             the error retrieve function is useless and may become useful or removed in future versions. The
; ..\BSW364\Os\Implementation\Os_Error.c	  1732             risk of keeping the code now is low as it is unit tested and code inspected and only returns read
; ..\BSW364\Os\Implementation\Os_Error.c	  1733             values (no write instructions at all).
; ..\BSW364\Os\Implementation\Os_Error.c	  1734  
; ..\BSW364\Os\Implementation\Os_Error.c	  1735  \ID COV_OS_ERRCODESECTIONCHECK
; ..\BSW364\Os\Implementation\Os_Error.c	  1736     \ACCEPT TX
; ..\BSW364\Os\Implementation\Os_Error.c	  1737     \REASON The feature Internal Exception Detection is always supported. Therefore the false branch is not covered.
; ..\BSW364\Os\Implementation\Os_Error.c	  1738             The risk of keeping the code is considered to be low as it is unit tested and reviewed.
; ..\BSW364\Os\Implementation\Os_Error.c	  1739  
; ..\BSW364\Os\Implementation\Os_Error.c	  1740  END_COVERAGE_JUSTIFICATION */
