; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	    99  /*! \brief         branch island for all exception vectors without user function (unhandled exception)
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   100   *                 it switches the stack and calls Os_Hal_UnhandledExc
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   101   *                 the parameter passed to Os_Hal_UnhandledExc are
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   102   *                    D4: exception class and TIN (already prepared by exception vector handler)
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   103   *                    D5: current PCXI value
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   104   *                    A4: causing address (potential return address)
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   105   *                    D6: current Stack memory region lower
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   106   *                    D7: current Stack memory region upper
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   107   *  \context      EXCEPTION VECTOR
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   108   *  \reentrant    FALSE
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   109   *  \synchronous  TRUE
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   110   *  \pre          -
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   111   **********************************************************************************************************************/
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   112  OS_FUNC_ATTRIBUTE_DECLARATION(void, OS_CODE, OS_HAL_NOINLINE, Os_Hal_UnhandledExceptionHandler, (void));
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   113  OS_FUNC_ATTRIBUTE_DEFINITION(void, OS_CODE, OS_HAL_NOINLINE, Os_Hal_UnhandledExceptionHandler, (void))
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   114  {
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   115    __asm ("mfcr d6, " OS_HAL_EXPAND(OS_HAL_COREMPU_DPR_LOW0));       /* prepare parameters for C-Function; D6 = OS_HAL_COREMPU_DPR_LOW0 */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   116    __asm ("mfcr d7, " OS_HAL_EXPAND(OS_HAL_COREMPU_DPR_UPPER0));     /* prepare parameters for C-Function; D7 = OS_HAL_COREMPU_DPR_UPPER0 */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   117    __asm ("mfcr d14, " OS_HAL_EXPAND(OS_HAL_CORE_ID_REGISTER));      /* get core ID; D14 = Physical Core ID */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   118    __asm ("and  d14, d14, 7");                                       /* mask core ID */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   119    __asm ("movh.a a4, %hi(OsCfg_Stack_KernelStacks)");               /* get address of the correct kernel stack (indexed by core ID) */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   120    __asm ("lea a4,[a4]%lo(OsCfg_Stack_KernelStacks)");               /* get address of the correct kernel stack (indexed by core ID); A4 = &OsCfg_Stack_KernelStacks */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   121    __asm ("addsc.a a15,a4,d14,2");                                   /* choose the correct element out of the array; A15 = &OsCfg_Stack_KernelStacks[Core ID] */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   122    __asm ("ld.a a15,[a15]");                                         /* get the pointer to the Os_Hal_ContextStackConfigType struct */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   123    __asm ("ld.w d12,[a15]");                                         /* get the content of Stack.StackRegionStart; D12 = Stack.StackRegionStart */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   124    __asm ("mtcr " OS_HAL_EXPAND(OS_HAL_COREMPU_DPR_LOW0) ", d12");   /* OS_HAL_COREMPU_DPR_LOW0 = D12 */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   125    __asm ("ld.w d12,[a15]4");                                        /* get the content of Stack.StackRegionEnd;   D12 = Stack.StackRegionEnd */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   126    __asm ("mtcr " OS_HAL_EXPAND(OS_HAL_COREMPU_DPR_UPPER0) ", d12"); /* OS_HAL_COREMPU_DPR_UPPER0 = D12 */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   127    __asm ("isync");
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   128    __asm ("mov.a a10, d12");                                         /* SP = Stack.StackRegionEnd; stack switch */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   129    __asm ("mfcr d5, " OS_HAL_EXPAND(OS_HAL_PCXI_OFFSET));            /* prepare parameters for C-Function; D5 = PCXI */
