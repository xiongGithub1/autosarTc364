; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   119    __asm ("movh.a a4, %hi(OsCfg_Stack_KernelStacks)");               /* get address of the correct kernel stack (indexed by core ID) */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   120    __asm ("lea a4,[a4]%lo(OsCfg_Stack_KernelStacks)");               /* get address of the correct kernel stack (indexed by core ID); A4 = &OsCfg_Stack_KernelStacks */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   121    __asm ("addsc.a a15,a4,d14,2");                                   /* choose the correct element out of the array; A15 = &OsCfg_Stack_KernelStacks[Core ID] */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   122    __asm ("ld.a a15,[a15]");                                         /* get the pointer to the Os_Hal_ContextStackConfigType struct */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   123    __asm ("ld.w d12,[a15]");                                         /* get the content of Stack.StackRegionStart; D12 = Stack.StackRegionStart */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   124    __asm ("mtcr " OS_HAL_EXPAND(OS_HAL_COREMPU_DPR_LOW0) ", d12");   /* OS_HAL_COREMPU_DPR_LOW0 = D12 */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   125    __asm ("ld.w d12,[a15]4");                                        /* get the content of Stack.StackRegionEnd;   D12 = Stack.StackRegionEnd */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   126    __asm ("mtcr " OS_HAL_EXPAND(OS_HAL_COREMPU_DPR_UPPER0) ", d12"); /* OS_HAL_COREMPU_DPR_UPPER0 = D12 */
