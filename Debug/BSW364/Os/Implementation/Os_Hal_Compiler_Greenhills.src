; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   131    __asm ("call Os_Hal_UnhandledExc");                               /* call the C-Function; the stack MPU regions are restored within the C-Function */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   132    __asm ("rslcx");                                                  /* restore lower context saved exception vector handler */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   133    __asm ("rfe");                                                    /* return from exception; old stack pointer is restored with this instruction */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   134  }
