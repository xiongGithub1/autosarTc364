; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   114  {
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   115    __asm ("mfcr d6, " OS_HAL_EXPAND(OS_HAL_COREMPU_DPR_LOW0));       /* prepare parameters for C-Function; D6 = OS_HAL_COREMPU_DPR_LOW0 */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   116    __asm ("mfcr d7, " OS_HAL_EXPAND(OS_HAL_COREMPU_DPR_UPPER0));     /* prepare parameters for C-Function; D7 = OS_HAL_COREMPU_DPR_UPPER0 */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   117    __asm ("mfcr d14, " OS_HAL_EXPAND(OS_HAL_CORE_ID_REGISTER));      /* get core ID; D14 = Physical Core ID */
