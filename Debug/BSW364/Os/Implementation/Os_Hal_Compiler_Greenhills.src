; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   139  /*! \brief         branch island for mem fault exception vector
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   140   *                 it switches the stack and calls Os_Hal_MemFault
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   141   *                 the parameter passed to Os_Hal_MemFault are
