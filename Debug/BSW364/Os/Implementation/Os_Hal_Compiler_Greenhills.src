; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	    99  /*! \brief         branch island for all exception vectors without user function (unhandled exception)
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   100   *                 it switches the stack and calls Os_Hal_UnhandledExc
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   101   *                 the parameter passed to Os_Hal_UnhandledExc are
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   102   *                    D4: exception class and TIN (already prepared by exception vector handler)
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   103   *                    D5: current PCXI value
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   104   *                    A4: causing address (potential return address)
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   105   *                    D6: current Stack memory region lower
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   106   *                    D7: current Stack memory region upper
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   107   *  \context      EXCEPTION VECTOR
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   108   *  \reentrant    FALSE
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   109   *  \synchronous  TRUE
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   110   *  \pre          -
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   111   **********************************************************************************************************************/
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Greenhills.c	   112  OS_FUNC_ATTRIBUTE_DECLARATION(void, OS_CODE, OS_HAL_NOINLINE, Os_Hal_UnhandledExceptionHandler, (void));
