; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	    89  /*! \brief         branch island for all exception vectors without user function (unhandled exception)
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	    90   *                 it switches the stack and calls Os_Hal_UnhandledExc
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	    91   *                 the parameter passed to Os_Hal_UnhandledExc are
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	    92   *                    D4: exception class and TIN (already prepared by exception vector handler)
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	    93   *                    D5: current PCXI value
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	    94   *                    A4: causing address (potential return address)
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	    95   *                    D6: current Stack memory region lower
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	    96   *                    D7: current Stack memory region upper
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	    97   *  \context      EXCEPTION VECTOR
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	    98   *  \reentrant    FALSE
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	    99   *  \synchronous  TRUE
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   100   *  \pre          -
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   101   **********************************************************************************************************************/
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   102  OS_FUNC_ATTRIBUTE_DECLARATION(void, OS_CODE, OS_HAL_NOINLINE, Os_Hal_UnhandledExceptionHandler, (void));
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   103  OS_FUNC_ATTRIBUTE_DEFINITION(void, OS_CODE, OS_HAL_NOINLINE, Os_Hal_UnhandledExceptionHandler, (void))
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   104  {
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   105    __asm ("  mfcr %d6, " OS_HAL_EXPAND(OS_HAL_COREMPU_DPR_LOW0));      /* prepare parameters for C-Function; D6 = OS_HAL_COREMPU_DPR_LOW0 */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   106    __asm ("  mfcr %d7, " OS_HAL_EXPAND(OS_HAL_COREMPU_DPR_UPPER0));    /* prepare parameters for C-Function; D7 = OS_HAL_COREMPU_DPR_UPPER0 */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   107    __asm ("  mfcr %d14, " OS_HAL_EXPAND(OS_HAL_CORE_ID_REGISTER));     /* get core ID; D14 = Core ID */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   108    __asm ("  and  %d14, %d14, 7");                                     /* mask core ID */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   109    __asm ("  movh.a %a4, OsCfg_Stack_KernelStacks@ha");                /* get address of the correct kernal stack (indexed by core ID) */                                  /* PRQA S 0286 */ /* MD_Os_Hal_Dir1.1_0286 */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   110    __asm ("  lea %a4,[%a4]OsCfg_Stack_KernelStacks@l");                /* get address of the correct kernal stack (indexed by core ID); A4 = &OsCfg_Stack_KernelStacks */  /* PRQA S 0286 */ /* MD_Os_Hal_Dir1.1_0286 */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   111    __asm ("  addsc.a %a15,%a4,%d14,2");                                /* choose the correct element out of the array; A15 = &OsCfg_Stack_KernelStacks[Core ID] */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   112    __asm ("  ld.a %a15,[%a15]");                                       /* get the pointer to the Os_Hal_ContextStackConfigType struct */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   113    __asm ("  ld.w %d12,[%a15]");                                       /* get the content of Stack.StackRegionStart; D12 = Stack.StackRegionStart */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   114    __asm ("  mtcr " OS_HAL_EXPAND(OS_HAL_COREMPU_DPR_LOW0)", %d12");   /* OS_HAL_COREMPU_DPR_LOW0 = D12 */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   115    __asm ("  ld.w %d12,[%a15]4");                                      /* get the content of Stack.StackRegionEnd;   D12 = Stack.StackRegionEnd */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   116    __asm ("  mtcr " OS_HAL_EXPAND(OS_HAL_COREMPU_DPR_UPPER0)", %d12"); /* OS_HAL_COREMPU_DPR_UPPER0 = D12 */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   117    __asm ("  isync");
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   118    __asm ("  mov.a %a10, %d12");                                       /* SP = Stack.StackRegionEnd; stack switch */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   119    __asm ("  mfcr %d5, " OS_HAL_EXPAND(OS_HAL_PCXI_OFFSET));           /* prepare parameters for C-Function; D5 = PCXI */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   120    __asm ("  mov.aa %a4, %a11");                                       /* prepare parameters for C-Function; A4 = Return Address (A11) */
