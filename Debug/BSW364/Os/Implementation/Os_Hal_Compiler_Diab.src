; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   120    __asm ("  mov.aa %a4, %a11");                                       /* prepare parameters for C-Function; A4 = Return Address (A11) */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   121    __asm ("  call Os_Hal_UnhandledExc");                               /* call the C-Function; the stack MPU regions are restored within the C-Function */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   122    __asm ("  rslcx");                                                  /* restore lower context saved exception vector handler */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   123    __asm ("  rfe");                                                    /* return from exception; old stackpointer is restored with this instruction */
