; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	    89  /*! \brief         branch island for all exception vectors without user function (unhandled exception)
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	    90   *                 it switches the stack and calls Os_Hal_UnhandledExc
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	    91   *                 the parameter passed to Os_Hal_UnhandledExc are
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	    92   *                    D4: exception class and TIN (already prepared by exception vector handler)
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	    93   *                    D5: current PCXI value
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	    94   *                    A4: causing address (potential return address)
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	    95   *                    D6: current Stack memory region lower
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	    96   *                    D7: current Stack memory region upper
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	    97   *  \context      EXCEPTION VECTOR
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	    98   *  \reentrant    FALSE
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	    99   *  \synchronous  TRUE
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   100   *  \pre          -
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   101   **********************************************************************************************************************/
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   102  OS_FUNC_ATTRIBUTE_DECLARATION(void, OS_CODE, OS_HAL_NOINLINE, Os_Hal_UnhandledExceptionHandler, (void));
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   103  OS_FUNC_ATTRIBUTE_DEFINITION(void, OS_CODE, OS_HAL_NOINLINE, Os_Hal_UnhandledExceptionHandler, (void))
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   104  {
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   105    __asm ("  mfcr %d6, " OS_HAL_EXPAND(OS_HAL_COREMPU_DPR_LOW0));      /* prepare parameters for C-Function; D6 = OS_HAL_COREMPU_DPR_LOW0 */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   106    __asm ("  mfcr %d7, " OS_HAL_EXPAND(OS_HAL_COREMPU_DPR_UPPER0));    /* prepare parameters for C-Function; D7 = OS_HAL_COREMPU_DPR_UPPER0 */
