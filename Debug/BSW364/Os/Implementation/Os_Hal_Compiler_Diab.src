; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   110    __asm ("  lea %a4,[%a4]OsCfg_Stack_KernelStacks@l");                /* get address of the correct kernal stack (indexed by core ID); A4 = &OsCfg_Stack_KernelStacks */  /* PRQA S 0286 */ /* MD_Os_Hal_Dir1.1_0286 */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   111    __asm ("  addsc.a %a15,%a4,%d14,2");                                /* choose the correct element out of the array; A15 = &OsCfg_Stack_KernelStacks[Core ID] */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   112    __asm ("  ld.a %a15,[%a15]");                                       /* get the pointer to the Os_Hal_ContextStackConfigType struct */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   113    __asm ("  ld.w %d12,[%a15]");                                       /* get the content of Stack.StackRegionStart; D12 = Stack.StackRegionStart */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   114    __asm ("  mtcr " OS_HAL_EXPAND(OS_HAL_COREMPU_DPR_LOW0)", %d12");   /* OS_HAL_COREMPU_DPR_LOW0 = D12 */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   115    __asm ("  ld.w %d12,[%a15]4");                                      /* get the content of Stack.StackRegionEnd;   D12 = Stack.StackRegionEnd */
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Diab.c	   116    __asm ("  mtcr " OS_HAL_EXPAND(OS_HAL_COREMPU_DPR_UPPER0)", %d12"); /* OS_HAL_COREMPU_DPR_UPPER0 = D12 */
