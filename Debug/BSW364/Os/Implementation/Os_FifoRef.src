; ..\BSW364\Os\Implementation\Os_FifoRef.c	   105  \ID SBSW_OS_FFREF_FIFOIDXINCREMENT_001
; ..\BSW364\Os\Implementation\Os_FifoRef.c	   106   \DESCRIPTION    Os_FifoIdxIncrement is called with a pointer derived from a Dyn pointer. The Dyn pointer is derived
; ..\BSW364\Os\Implementation\Os_FifoRef.c	   107                   from an caller's Fifo argument. The correctness of the Fifo argument is ensured by precondition.
; ..\BSW364\Os\Implementation\Os_FifoRef.c	   108                   The compliance of the precondition is check during review.
; ..\BSW364\Os\Implementation\Os_FifoRef.c	   109   \COUNTERMEASURE \M [CM_OS_FIFOREFREAD_DYN_M]
; ..\BSW364\Os\Implementation\Os_FifoRef.c	   110  
