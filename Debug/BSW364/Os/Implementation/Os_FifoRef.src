; ..\BSW364\Os\Implementation\Os_FifoRef.c	   141  /*
; ..\BSW364\Os\Implementation\Os_FifoRef.c	   142  \CM CM_OS_FIFOREFREAD_DYN_M
; ..\BSW364\Os\Implementation\Os_FifoRef.c	   143        Verify that the Dyn pointer of each Os_FifoRefReadConfigType object is a non NULL_REF.
; ..\BSW364\Os\Implementation\Os_FifoRef.c	   144  
; ..\BSW364\Os\Implementation\Os_FifoRef.c	   145  \CM CM_OS_FIFOREFWRITE_DYN_M
; ..\BSW364\Os\Implementation\Os_FifoRef.c	   146        Verify that the Dyn pointer of each Os_FifoRefWriteConfigType object is a non NULL_REF.
