; ..\BSW364\Os\Implementation\Os_FifoRef.c	   148  \CM CM_OS_FIFOREFWRITE_DATA_M
; ..\BSW364\Os\Implementation\Os_FifoRef.c	   149        Verify that
; ..\BSW364\Os\Implementation\Os_FifoRef.c	   150          1. the Data pointer of each Os_FifoRefWriteConfigType object is a non NULL_REF.
; ..\BSW364\Os\Implementation\Os_FifoRef.c	   151          2. the size of the Data array equals Fifo.Size,
; ..\BSW364\Os\Implementation\Os_FifoRef.c	   152          3. the corresponding Os_FifoRefReadConfigType instance refers to the same Data array.
; ..\BSW364\Os\Implementation\Os_FifoRef.c	   153  
; ..\BSW364\Os\Implementation\Os_FifoRef.c	   154  \CM CM_OS_FIFOREF_WRITECBK_DATA_M
; ..\BSW364\Os\Implementation\Os_FifoRef.c	   155        Verify that the WriteCallback of each Os_FifoRefWriteConfigType instance is a non NULL_PTR.
; ..\BSW364\Os\Implementation\Os_FifoRef.c	   156  
; ..\BSW364\Os\Implementation\Os_FifoRef.c	   157  \CM CM_OS_FIFOREF_READCBK_DATA_M
