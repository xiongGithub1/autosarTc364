; ..\BSW364\Os\Implementation\Os_FifoRef.c	   101   \COUNTERMEASURE \T TCASE-345817
; ..\BSW364\Os\Implementation\Os_FifoRef.c	   102                   \M [CM_OS_FIFOREFWRITE_DYN_M]
