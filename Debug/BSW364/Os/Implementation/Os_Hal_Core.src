; ..\BSW364\Os\Implementation\Os_Hal_Core.c	   169  
; ..\BSW364\Os\Implementation\Os_Hal_Core.c	   170  \ID COV_OS_TESTCODE
; ..\BSW364\Os\Implementation\Os_Hal_Core.c	   171     \ACCEPT XX
