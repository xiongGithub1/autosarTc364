; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   127  
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   128  #if (PDUR_EXISTS_TP_BUFFERED_ROUTINGTYPEOFRMDESTROM == STD_ON)
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   129  /**********************************************************************************************************************
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   130    PduR_RmTp_CopyTxData
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   131  **********************************************************************************************************************/
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   132  /*! \brief      This function is called by the PduR GwTp to query the transmit data of an I-PDU segment.
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   133   *  \details    Each call to this function copies the next part of the transmit.
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   134   *  \param[in]      rmGDestRomIdx       ID of the GwTp I-PDU that will be transmitted.
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   135   *  \param[in]      info              Pointer to the destination buffer and the number of bytes to copy.
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   136   *                                In case of gateway the PDU Router module will copy otherwise the source upper layer
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   137   *                                module will copy the data. If not enough transmit data is available, no data is copied.
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   138   *
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   139   *                                A copy size of 0 can be used to indicate state changes in the retry parameter.
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   140   *  \param[in]  retry             not supported
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   141   *  \param[out] availableDataPtr  Indicates the remaining number of bytes that are available in the PduR Tx buffer.
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   142   *                                AvailableTxDataCntPtr can be used by TP modules that support dynamic payload lengths
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   143   *                                (e.g. Iso FrTp) to determine the size of the following CFs.
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   144   *  \return     BufReq_ReturnType
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   145   *              BUFREQ_OK         The data has been copied to the transmit buffer successful.
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   146   *              BUFREQ_E_NOT_OK   PduR_Init() has not been called
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   147   *                                or the GwTpTxPduId is not valid
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   148   *                                or the GwTpTxPduId is not forwarded in this identity
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   149   *                                or the info is not valid
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   150   *                                or the request was not accepted by the upper layer and no data has been copied.
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   151   *              BUFREQ_E_BUSY     The request cannot be processed because the TX data is not available
