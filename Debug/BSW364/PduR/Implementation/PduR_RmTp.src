; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   114  /*! \brief       The function is called by the PduR to trigger the transmission on the destination buses in case of a
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   115   *                FanIn Transport Protocol Routing.
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   116   *   \details     The PDU Router evaluates the Gw I-PDU handle and performs appropriate handle and port conversion.
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   117   *                The call is routed to multiple TP module using the appropriate I-PDU handle of the destination layer.
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   118   *   \param[in]   rmDestRomIdx             ID of the transmitted GwTp I-PDU.
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   119   *   \param[in]   info                     the pointer to the data
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   120   *   \pre         -
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   121   *   \context     TASK|ISR1|ISR2
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   122   *   \reentrant   TRUE
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   123   *   \synchronous TRUE
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   124  **********************************************************************************************************************/
; ..\BSW364\PduR\Implementation\PduR_RmTp.c	   125  PDUR_LOCAL_INLINE FUNC(Std_ReturnType, PDUR_CODE) PduR_RmTp_MultipleSourceHandler_Transmit(PduR_RmDestRomIterType rmDestRomIdx, P2CONST(PduInfoType, AUTOMATIC, PDUR_APPL_DATA) info);
