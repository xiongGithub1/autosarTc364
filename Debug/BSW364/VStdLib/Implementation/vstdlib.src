; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3507  
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3508  /***********************************************************************************************************************
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3509   *  MISRA JUSTIFICATIONS
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3510   **********************************************************************************************************************/
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3511  
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3512  /* Justification for module-specific MISRA deviations:
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3513  
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3514   MD_VStdLib_NoCaseBreak:
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3515     Reason:     Break statements are omitted due to performance reasons when using jump tables.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3516     Risk:       Resulting code is misleading.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3517     Prevention: Code comments, code inspection and test of the different variants in the component test.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3518  
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3519   MD_VStdLib_ParamMod:
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3520     Reason:     Pointers and counts given as function parameters are modified during different algorithm stages.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3521     Risk:       Wrong pointer access is performed.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3522     Prevention: Silent analysis, code inspection and test of the different variants in the component test.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3523  
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3524   MD_VStdLib_ParamValueMod:
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3525     Reason:     The direct modification of the function parameter leads to code which is easier to read and maintain.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3526     Risk:       Incorrect expectation of the value of the modified function parameter.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3527     Prevention: Code inspection and test of the different variants in the component test.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3528  
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3529   MD_VStdLib_PtrCast:
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3530     Reason:     Pointer is casted as different memory access sizes are utilized due to performance reasons.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3531     Risk:       Wrong pointer access is performed.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3532     Prevention: Code inspection and test of the different variants in the component test.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3533  
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3534   MD_VStdLib_PtrCastToInt:
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3535     Reason:     Pointer is casted to an integral type in order to get the target alignment.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3536     Risk:       None, as only LSBs are evaluated.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3537     Prevention: None.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3538  
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3539   MD_VStdLib_Para2ConstPtr
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3540     Reason:     The address of a parameter is stored in a constant pointer in order to use the VStdLib_MemCpy().
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3541     Risk:       None.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3542     Prevention: None.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3543  
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3544   MD_VStdLib_NotUsedInUnit:
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3545     Reason:     Static inline function is not used within this translation unit, because it is intended to be used as
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3546                 a inline function by other modules.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3547     Risk:       None.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3548     Prevention: None.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3549  
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3550   MD_VStdLib_FileScope:
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3551     Reason:     Constant tables are kept at a central location for a better overview and maintenance.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3552     Risk:       None.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3553     Prevention: None.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3554  
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3555   MD_VStdLib_Metrics:
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3556     Reason:     No separation of functionality due to performance reasons when using jump tables.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3557     Risk:       None, as the complexity arises from one single switch statement.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3558     Prevention: None.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3559  
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3560  */
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3561  
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3562  /***********************************************************************************************************************
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3563   *  SILENTBSW JUSTIFICATIONS
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3564   **********************************************************************************************************************/
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3565  
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3566  /* SBSW_JUSTIFICATION_BEGIN
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3567  
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3568   \ID SBSW_VSTDLIB_CALL_UNMODIFIED
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3569     \DESCRIPTION A function is called with unmodified 'pDst' and 'nCnt' parameters.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3570     \COUNTERMEASURE \N The caller of the function ensures that 'pDst' and 'nCnt' are valid. These parameters are passed
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3571                        to the callee without modifications. If the parameters are casted there are no side effects.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3572  
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3573   \ID SBSW_VSTDLIB_CALL_MODIFIED_CNT
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3574     \DESCRIPTION A static function is called with unmodified 'pDst' parameter and a modified 'nCnt' parameter.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3575     \COUNTERMEASURE \N The caller of the function ensures that 'pDst' and 'nCnt' are valid. The offset value is
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3576                        always smaller than 4 due to VSTDLIB_ALIGN_OFFSET() and 'nCnt' is 32 or higher at this point.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3577                        Therefore 'pDst' and 'nCnt' for the callee are valid.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3578  
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3579   \ID SBSW_VSTDLIB_CALL_MODIFIED_PTR_CNT
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3580     \DESCRIPTION A static function can be called with unmodified or modified 'pDst' and 'nCnt' parameters.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3581     \COUNTERMEASURE \N The caller of the function ensures that 'pDst' and 'nCnt' are valid. In case the function is
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3582                        called with modified parameters (pointer alignment was performed), 'pDst' is incremented by
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3583                        the value of 'nDstOffset' and 'nCnt' is decremented by the same value. Therefore 'pDst'
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3584                        and 'nCnt' for the callee are valid.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3585  
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3586   \ID SBSW_VSTDLIB_ACCESS_LOOP
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3587     \DESCRIPTION Linear memory access using a for loop.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3588     \COUNTERMEASURE \N The caller of this function ensures that 'pDst' and 'nCnt' are valid. The for loop ensures that
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3589                        the loop index is always smaller than nCnt. Therefore only valid memory is accessed.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3590  
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3591   \ID SBSW_VSTDLIB_ACCESS_8_JUMPTABLE
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3592     \DESCRIPTION Linear 8-bit-access using a switch statement.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3593     \COUNTERMEASURE \N The caller of this function ensures that 'pDst' and 'nCnt' are valid. The constant indices are
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3594                        always smaller than the value of 'nCnt'. Therefore only valid memory is accessed.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3595  
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3596   \ID SBSW_VSTDLIB_ACCESS_32_LOOP
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3597     \DESCRIPTION Linear 32-bit-access using a for loop.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3598     \COUNTERMEASURE \N The caller of this function ensures that 'pDst' and 'nCnt' are valid. The access index 'dPos'
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3599                        is initialized with 0. The loop control variable 'remaining' is decremented by 16 per iteration.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3600                        The exit condition ensures that at least 16 bytes are valid per iteration. The access index
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3601                        'dPos' plus constant offset ensures that exactly 16 valid bytes are accessed. 'dPos' is
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3602                        incremented by 4 (that equals 16 bytes) after the access.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3603  
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3604   \ID SBSW_VSTDLIB_ACCESS_32_LOOP_REMAINING
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3605     \DESCRIPTION Linear 32-bit-access using a for loop.
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3606     \COUNTERMEASURE \N The caller of this function ensures that 'pDst' and 'nCnt' are valid. After the for loop above
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3607                        'remaining' bytes of valid memory start at the address that is indicated by 'dPos'. The loop
; ..\BSW364\VStdLib\Implementation\vstdlib.c	  3608                        control variable 'remaining' is decremented by 4 per iteration. The exit condition ensures that
