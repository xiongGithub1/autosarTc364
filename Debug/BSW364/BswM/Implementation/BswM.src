; ..\BSW364\BswM\Implementation\BswM.c	   889  
; ..\BSW364\BswM\Implementation\BswM.c	   890    /* #10 Set the last element of the priority queue to the position of the found index and reduce the list length. */
; ..\BSW364\BswM\Implementation\BswM.c	   891    BswM_DecLengthOfActionListPriorityQueue(partitionIdx); /* SBSW_BSWM_PARTITIONINDEXACCESS */
