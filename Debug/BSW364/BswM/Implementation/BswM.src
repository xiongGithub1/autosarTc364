; ..\BSW364\BswM\Implementation\BswM.c	   920      }
; ..\BSW364\BswM\Implementation\BswM.c	   921  
; ..\BSW364\BswM\Implementation\BswM.c	   922      /* Swap parent with minimum child */
; ..\BSW364\BswM\Implementation\BswM.c	   923      temp = BswM_GetActionListPriorityQueue(leftChild, partitionIdx); /*lint -e{661, 662} */
