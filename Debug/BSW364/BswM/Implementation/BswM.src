; ..\BSW364\BswM\Implementation\BswM.c	   793      }
; ..\BSW364\BswM\Implementation\BswM.c	   794  
; ..\BSW364\BswM\Implementation\BswM.c	   795      /* #30 If there was no minimum Action List Queue item for the given executionLevel, return the size of Action List Queue */
; ..\BSW364\BswM\Implementation\BswM.c	   796      if (priorityQueueIdx < BswM_GetSizeOfActionListPriorityQueue(partitionIdx)) /*lint -e{661, 662} */
; ..\BSW364\BswM\Implementation\BswM.c	   797      {
; ..\BSW364\BswM\Implementation\BswM.c	   798        /* #40 Otherwise, return the found Action List Queue item and remove it from the queue */
; ..\BSW364\BswM\Implementation\BswM.c	   799        minActionListIdx = (BswM_SizeOfActionListQueueType)BswM_GetActionListPriorityQueue(priorityQueueIdx, partitionIdx);
; ..\BSW364\BswM\Implementation\BswM.c	   800  
; ..\BSW364\BswM\Implementation\BswM.c	   801        BswM_RemoveIdxFromQueue(priorityQueueIdx, partitionIdx); /*lint -e{661, 662} */
; ..\BSW364\BswM\Implementation\BswM.c	   802      }
; ..\BSW364\BswM\Implementation\BswM.c	   803    }
