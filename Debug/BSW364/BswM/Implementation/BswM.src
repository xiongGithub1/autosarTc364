; ..\BSW364\BswM\Implementation\BswM.c	   781    if (BswM_GetLengthOfActionListPriorityQueue(partitionIdx) > 0u)
; ..\BSW364\BswM\Implementation\BswM.c	   782    {
; ..\BSW364\BswM\Implementation\BswM.c	   783      /* #20 If there are elements in the queue, determine the minimum Action List Queue item that matches the provided executionLevel */
