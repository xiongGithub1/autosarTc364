; ..\BSW364\BswM\Implementation\BswM.c	   821  BSWM_LOCAL_INLINE FUNC(BswM_SizeOfActionListPriorityQueueType, BSWM_CODE) BswM_DetermineMinimalQueueIdx(uint8 executionLevel, BswM_PCPartitionConfigIdxOfPartitionIdentifiersType partitionIdx)
; ..\BSW364\BswM\Implementation\BswM.c	   822  {
; ..\BSW364\BswM\Implementation\BswM.c	   823    /* ----- Local Variables ---------------------------------------------- */
; ..\BSW364\BswM\Implementation\BswM.c	   824    BswM_SizeOfActionListPriorityQueueType tempPriorityQueueIdx, priorityQueueIdx, lastIdxInLevel;
; ..\BSW364\BswM\Implementation\BswM.c	   825    BswM_SizeOfActionListQueueType minActionListIdx = BswM_GetSizeOfActionListQueue(partitionIdx);
; ..\BSW364\BswM\Implementation\BswM.c	   826    BswM_SizeOfActionListQueueType minActionListIdxInLevel = BswM_GetSizeOfActionListQueue(partitionIdx);
; ..\BSW364\BswM\Implementation\BswM.c	   827  
; ..\BSW364\BswM\Implementation\BswM.c	   828    /* ----- Implementation ----------------------------------------------- */
; ..\BSW364\BswM\Implementation\BswM.c	   829    lastIdxInLevel = 0u;
; ..\BSW364\BswM\Implementation\BswM.c	   830    priorityQueueIdx = BswM_GetSizeOfActionListPriorityQueue(partitionIdx);
; ..\BSW364\BswM\Implementation\BswM.c	   831  
; ..\BSW364\BswM\Implementation\BswM.c	   832    for( tempPriorityQueueIdx = 0u; tempPriorityQueueIdx < BswM_GetLengthOfActionListPriorityQueue(partitionIdx); tempPriorityQueueIdx++ )
; ..\BSW364\BswM\Implementation\BswM.c	   833    {
; ..\BSW364\BswM\Implementation\BswM.c	   834      BswM_SizeOfActionListQueueType currentActionListIndex = BswM_GetActionListPriorityQueue(tempPriorityQueueIdx, partitionIdx);
; ..\BSW364\BswM\Implementation\BswM.c	   835        /* #10 Iterate over the ActionListPriorityQueue elements of the same level (all children) and search for 
; ..\BSW364\BswM\Implementation\BswM.c	   836               an action with the minimal action list index and the passed executionLevel. */
; ..\BSW364\BswM\Implementation\BswM.c	   837      if ( (currentActionListIndex < minActionListIdx) &&
; ..\BSW364\BswM\Implementation\BswM.c	   838            (BswM_GetActionListQueue(currentActionListIndex, partitionIdx) == executionLevel))
; ..\BSW364\BswM\Implementation\BswM.c	   839      {
; ..\BSW364\BswM\Implementation\BswM.c	   840        priorityQueueIdx = tempPriorityQueueIdx;
; ..\BSW364\BswM\Implementation\BswM.c	   841        minActionListIdx = currentActionListIndex;
; ..\BSW364\BswM\Implementation\BswM.c	   842      }
; ..\BSW364\BswM\Implementation\BswM.c	   843      else if(currentActionListIndex < minActionListIdxInLevel)
; ..\BSW364\BswM\Implementation\BswM.c	   844      {
; ..\BSW364\BswM\Implementation\BswM.c	   845        minActionListIdxInLevel = currentActionListIndex;
; ..\BSW364\BswM\Implementation\BswM.c	   846      }
; ..\BSW364\BswM\Implementation\BswM.c	   847      else
; ..\BSW364\BswM\Implementation\BswM.c	   848      {
; ..\BSW364\BswM\Implementation\BswM.c	   849        /* Element has not the smallest index on level. */
; ..\BSW364\BswM\Implementation\BswM.c	   850      }
; ..\BSW364\BswM\Implementation\BswM.c	   851  
; ..\BSW364\BswM\Implementation\BswM.c	   852      /* #20 In case that an element was found on a level and this element has the minimal index on this level, 
; ..\BSW364\BswM\Implementation\BswM.c	   853             the search is over. Other elements on deeper levels can not have a smaller index because of the min heap 
; ..\BSW364\BswM\Implementation\BswM.c	   854             property that parents have always the higher priority compared to the children. */
; ..\BSW364\BswM\Implementation\BswM.c	   855      if( tempPriorityQueueIdx == lastIdxInLevel )
; ..\BSW364\BswM\Implementation\BswM.c	   856      {
; ..\BSW364\BswM\Implementation\BswM.c	   857        if(minActionListIdx < minActionListIdxInLevel)
; ..\BSW364\BswM\Implementation\BswM.c	   858        {
; ..\BSW364\BswM\Implementation\BswM.c	   859          break;
; ..\BSW364\BswM\Implementation\BswM.c	   860        }
; ..\BSW364\BswM\Implementation\BswM.c	   861        /* #30 Otherwise the search has to be continued on a deeper level. */
; ..\BSW364\BswM\Implementation\BswM.c	   862        minActionListIdxInLevel = BswM_GetSizeOfActionListQueue(partitionIdx);
; ..\BSW364\BswM\Implementation\BswM.c	   863        lastIdxInLevel = (BswM_SizeOfActionListPriorityQueueType)((lastIdxInLevel << 1) + 2u);
; ..\BSW364\BswM\Implementation\BswM.c	   864      }
; ..\BSW364\BswM\Implementation\BswM.c	   865    }
; ..\BSW364\BswM\Implementation\BswM.c	   866  
; ..\BSW364\BswM\Implementation\BswM.c	   867    BSWM_DUMMY_STATEMENT(partitionIdx); /* PRQA S 1338, 2983, 3112 */ /* MD_MSR_DummyStmt */
; ..\BSW364\BswM\Implementation\BswM.c	   868    return priorityQueueIdx;
; ..\BSW364\BswM\Implementation\BswM.c	   869  }
