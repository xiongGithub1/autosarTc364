; ..\BSW364\BswM\Implementation\BswM.c	   785      /* In case of executionLevel BSWM_ACTIONLIST_PENDING the element on position 0 of the queue has the minimal action list index */
; ..\BSW364\BswM\Implementation\BswM.c	   786      if (executionLevel == BSWM_ACTIONLIST_PENDING)
