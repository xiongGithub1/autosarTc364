; ..\BSW364\BswM\Implementation\BswM.c	   909      }
; ..\BSW364\BswM\Implementation\BswM.c	   910      /* Check if the left child has minimum priority */
; ..\BSW364\BswM\Implementation\BswM.c	   911      else if ((leftChild < BswM_GetLengthOfActionListPriorityQueue(partitionIdx)) &&
