; ..\BSW364\BswM\Implementation\BswM.c	   852      /* #20 In case that an element was found on a level and this element has the minimal index on this level, 
; ..\BSW364\BswM\Implementation\BswM.c	   853             the search is over. Other elements on deeper levels can not have a smaller index because of the min heap 
