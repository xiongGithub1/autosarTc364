; ..\BSW364\BswM\Implementation\BswM.c	   835        /* #10 Iterate over the ActionListPriorityQueue elements of the same level (all children) and search for 
; ..\BSW364\BswM\Implementation\BswM.c	   836               an action with the minimal action list index and the passed executionLevel. */
