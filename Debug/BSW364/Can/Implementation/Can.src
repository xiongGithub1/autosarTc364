; ..\BSW364\Can\Implementation\Can.c	  6108       4) First reset CCCR.CSR
; ..\BSW364\Can\Implementation\Can.c	  6109       5) Then reset CCCR.INIT
; ..\BSW364\Can\Implementation\Can.c	  6110       6) Wait until CCCR.INIT is read as zero
; ..\BSW364\Can\Implementation\Can.c	  6111       7) Issue a second clock stop request by setting bit CCCR.CSR
; ..\BSW364\Can\Implementation\Can.c	  6112       8) Wait until the M_CAN sets CCCR.INIT and CCCR.CSA to one
; ..\BSW364\Can\Implementation\Can.c	  6113       9) Set CCCR.CCE and reset CCCR.CSR */
