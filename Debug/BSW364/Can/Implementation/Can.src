; ..\BSW364\Can\Implementation\Can.c	  7578      /* While CCCR[INIT] is set, message transfer from and to the CAN bus is stopped, the status of the CAN bus transmit output is recessive (HIGH). 
; ..\BSW364\Can\Implementation\Can.c	  7579         Setting CCCR[INIT] does not change any configuration register. 
; ..\BSW364\Can\Implementation\Can.c	  7580         After resetting CCCR[INIT] the Bit Stream Processor (BSP) synchronizes itself to the data transfer on the CAN bus 
; ..\BSW364\Can\Implementation\Can.c	  7581         by waiting for the occurrence of a sequence of 11 consecutive recessive bits (= Bus_Idle) before it can take part in bus activities and start the message transfer. */
; ..\BSW364\Can\Implementation\Can.c	  7582  #if ( CAN_BOSCH_ERRATUM_008 == STD_ON ) /* COV_CAN_ERRATUM_OFF */
; ..\BSW364\Can\Implementation\Can.c	  7583      /* When CCCR.INIT is set while the M_CAN is receiving a frame, the next received frame         
; ..\BSW364\Can\Implementation\Can.c	  7584         after resetting CCCR.INIT will cause IR.MRAF to be set.
; ..\BSW364\Can\Implementation\Can.c	  7585          Workaround:
; ..\BSW364\Can\Implementation\Can.c	  7586          1) Issue a clock stop request by setting bit CCCR.CSR
; ..\BSW364\Can\Implementation\Can.c	  7587          2) Wait until the M_CAN sets CCCR.INIT and CCCR.CSA to one
; ..\BSW364\Can\Implementation\Can.c	  7588             Before resetting CCCR.INIT first reset CCCR.CSR. */
; ..\BSW364\Can\Implementation\Can.c	  7589  #endif
; ..\BSW364\Can\Implementation\Can.c	  7590      /* #20 request mode transition if not reached yet */
; ..\BSW364\Can\Implementation\Can.c	  7591      /* Put HW to halt mode, if it is not already there */
; ..\BSW364\Can\Implementation\Can.c	  7592      /*  Power down:
; ..\BSW364\Can\Implementation\Can.c	  7593          The M_CAN can be set into power down mode via CCCR[CSR]. 
; ..\BSW364\Can\Implementation\Can.c	  7594          When clock stop is requested (CCCR[CSR]='1') first INIT and then CSA will be set after all pending transfer requests are completed and the CAN bus reached idle.
; ..\BSW364\Can\Implementation\Can.c	  7595          1)  As long as the clock stop request signal is active, bit CCCR[CSR] is read as one. 
; ..\BSW364\Can\Implementation\Can.c	  7596          1a) When all pending transmission requests have completed, 
; ..\BSW364\Can\Implementation\Can.c	  7597          1b) then M_CAN waits until bus idle state is detected. 
; ..\BSW364\Can\Implementation\Can.c	  7598          2)  The M_CAN sets CCCR[INIT] to one to prevent any further CAN transfers. 
; ..\BSW364\Can\Implementation\Can.c	  7599          3)  Now M_CAN acknowledges that it is ready for power down by setting CCCR[CSA] to one. 
; ..\BSW364\Can\Implementation\Can.c	  7600              In this state, before the clocks are switched off, further register accesses can be made. 
; ..\BSW364\Can\Implementation\Can.c	  7601              A write access to CCCR[INIT] will have no effect. 
; ..\BSW364\Can\Implementation\Can.c	  7602          4)  Now the module clock inputs (CAN clock and host clock) may be switched off. 
; ..\BSW364\Can\Implementation\Can.c	  7603          5)  To leave power down mode, the application has to turn on the module clocks before resetting CCCR[CSR]. 
; ..\BSW364\Can\Implementation\Can.c	  7604          5a) The M_CAN will acknowledge this by resetting CCCR[CSA]. 
; ..\BSW364\Can\Implementation\Can.c	  7605          6)  Afterwards, the application can restart CAN communication by resetting bit CCCR[INIT]. */
; ..\BSW364\Can\Implementation\Can.c	  7606  #if ( CAN_BOSCH_ERRATUM_008 == STD_ON ) /* COV_CAN_ERRATUM_OFF */
; ..\BSW364\Can\Implementation\Can.c	  7607      Cn->CCCR |= kCanCCCR_CSR;   /* SBSW_CAN_LL_100 */    /* PRQA S 0303 */ /* MD_Can_HwAccess */
; ..\BSW364\Can\Implementation\Can.c	  7608      /*  When clock stop is requested, first INIT then CSA will be set 
; ..\BSW364\Can\Implementation\Can.c	  7609          after all pending transfer requests have been completed and the CAN bus reached idle. */
