; ..\Appl\GenData\PduR_Lcfg.c	   685                         
; ..\Appl\GenData\PduR_Lcfg.c	   686    \ID SBSW_PDUR_EXTERNAL_API_CALL_FORWARDING_ONLY
; ..\Appl\GenData\PduR_Lcfg.c	   687      \DESCRIPTION    The API call is forwarded to an internal function.
; ..\Appl\GenData\PduR_Lcfg.c	   688      \COUNTERMEASURE \N The parameter are checked in the called function.
; ..\Appl\GenData\PduR_Lcfg.c	   689  
