                      <COMMUNICATION-CONNECTOR-REF DEST="CAN-COMMUNICATION-CONNECTOR">/ECU/MyECU/CN_CAN00</COMMUNICATION-CONNECTOR-REF>
                    </COMMUNICATION-CONNECTOR-REF-CONDITIONAL>
