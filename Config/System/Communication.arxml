    <AR-PACKAGE>
      <SHORT-NAME>CanFrame</SHORT-NAME>
      <ELEMENTS>
        <CAN-FRAME>
          <SHORT-NAME>msg_diag_Request_MyECU_oCAN00</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">UDS physical request (ID 0x74C, Tester -&gt; MyECU), 8 bytes classic CAN. Dcm Rx PDU (physical addressing).</L-2>
          </DESC>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>msg_diag_Request_MyECU_Tp</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="N-PDU">/PDU/msg_diag_Request_MyECU_Tp_oCAN00</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>msg_diag_RequestGlobal_oCAN00</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">UDS functional request (ID 0x7DF, broadcast), 8 bytes classic CAN. Dcm Rx PDU (functional addressing).</L-2>
          </DESC>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>msg_diag_RequestGlobal_Tp</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="N-PDU">/PDU/msg_diag_RequestGlobal_Tp_oCAN00</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>msg_diag_Response_MyECU_oCAN00</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">UDS physical response (ID 0x75C, MyECU -&gt; Tester), 8 bytes classic CAN. Dcm Tx PDU.</L-2>
          </DESC>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>msg_diag_Response_MyECU_Tp</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="N-PDU">/PDU/msg_diag_Response_MyECU_Tp_oCAN00</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>msg_MotorStatus_oCAN00</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">MyECU TX motor status (Com). Cycle 5 ms, CAN FD. Signals align with RTE: MotorMode, tle9180_Ov_Fault, Id_Ref, Iq_Ref, Vbus, ElectricAngle. Observation only; mode/current commands via XCP RAM write, not Com Rx.</L-2>
          </DESC>
          <FRAME-LENGTH>12</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>msg_MotorStatus</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="I-SIGNAL-I-PDU">/PDU/msg_MotorStatus_oCAN00</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>msg_nm_MyECU_oCAN00</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">CanNm ASR TX MyECU ID=0x600. Layout 8B: [SNI/NID][CBV][UserData0..5]. CanNm fills SNI+CBV; Com UserDataTxPdu length must be 6.</L-2>
          </DESC>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>msg_nm_MyECU</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="NM-PDU">/PDU/msg_nm_MyECU_oCAN00</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>msg_nm_RearECU_oCAN00</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">CanNm ASR TX RearECU ID=0x601. Same 8B layout. MyECU RX via CanNm range 0x600-0x6FF.</L-2>
          </DESC>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>msg_nm_RearECU</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="NM-PDU">/PDU/msg_nm_RearECU_oCAN00</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>msg_Receive_oCAN00</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Legacy demo RX frame (kept for existing CanIf/Com). Prefer remove in later series cleanup if unused.</L-2>
          </DESC>
          <FRAME-LENGTH>1</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>msg_Receive</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="I-SIGNAL-I-PDU">/PDU/msg_Receive_oCAN00</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>msg_Transmit_oCAN00</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Legacy demo TX frame (kept for existing CanIf/Com). Prefer remove in later series cleanup if unused.</L-2>
          </DESC>
          <FRAME-LENGTH>1</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>msg_Transmit</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="I-SIGNAL-I-PDU">/PDU/msg_Transmit_oCAN00</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
      </ELEMENTS>
    </AR-PACKAGE>
    <AR-PACKAGE>
      <SHORT-NAME>PDU</SHORT-NAME>
      <ELEMENTS>
        <I-SIGNAL-I-PDU>
          <SHORT-NAME>msg_MotorStatus_oCAN00</SHORT-NAME>
          <LENGTH>12</LENGTH>
          <I-PDU-TIMING-SPECIFICATIONS>
            <I-PDU-TIMING>
              <MINIMUM-DELAY>0</MINIMUM-DELAY>
              <TRANSMISSION-MODE-DECLARATION>
                <TRANSMISSION-MODE-FALSE-TIMING>
                  <CYCLIC-TIMING>
                    <TIME-OFFSET>
                      <VALUE>0</VALUE>
                    </TIME-OFFSET>
                    <TIME-PERIOD>
                      <VALUE>0.005</VALUE>
                    </TIME-PERIOD>
                  </CYCLIC-TIMING>
                </TRANSMISSION-MODE-FALSE-TIMING>
                <TRANSMISSION-MODE-TRUE-TIMING>
                  <CYCLIC-TIMING>
                    <TIME-OFFSET>
                      <VALUE>0</VALUE>
                    </TIME-OFFSET>
                    <TIME-PERIOD>
                      <VALUE>0.005</VALUE>
                    </TIME-PERIOD>
                  </CYCLIC-TIMING>
                </TRANSMISSION-MODE-TRUE-TIMING>
              </TRANSMISSION-MODE-DECLARATION>
            </I-PDU-TIMING>
          </I-PDU-TIMING-SPECIFICATIONS>
          <I-SIGNAL-TO-PDU-MAPPINGS>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>MotorMode</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/ISignal/MotorMode_omsg_MotorStatus_oCAN00</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>0</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>tle9180_Ov_Fault</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/ISignal/tle9180_Ov_Fault_omsg_MotorStatus_oCAN00</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>8</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>Id_Ref</SHORT-NAME>
