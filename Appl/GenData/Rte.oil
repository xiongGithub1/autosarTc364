/**********************************************************************************************************************
 *                                              P L E A S E   N O T E
 *
 * The attributes in this file must not be changed. Missing mandatory attributes must be set in the including file.
 * They are presented as a comment in the corresponding object definition containing a list of all legal values.
 *********************************************************************************************************************/

   TASK Default_Appl_Init_Task {
      ACTIVATION = 1:"@RO@";
      PRIORITY = 45:"@RO@";
      SCHEDULE = NON:"@RO@";
// TIMING_PROTECTION = FALSE|TRUE; (AUTOSAR OS only)
      AUTOSTART = FALSE:"@RO@";
   }:"@RO@@NR@";

   TASK Default_Appl_Task {
      ACTIVATION = 1:"@RO@";
      PRIORITY = 5:"@RO@";
      SCHEDULE = NON:"@RO@";
// TIMING_PROTECTION = FALSE|TRUE; (AUTOSAR OS only)
      AUTOSTART = FALSE:"@RO@";
      EVENT = Rte_Ev_Run_StartApp_StartApp_Cyclic1ms:"@RO@";
      EVENT = Rte_Ev_Run_StartApp_StartApp_Cyclic500ms:"@RO@";
   }:"@RO@@NR@";

   ALARM Rte_Al_TE_StartApp_StartApp_Cyclic1ms {
      COUNTER = SystemTimer;
      ACTION = SETEVENT
      {
         TASK = Default_Appl_Task;
         EVENT = Rte_Ev_Run_StartApp_StartApp_Cyclic1ms;
      }:"@ROC@";
      AUTOSTART = FALSE:"@RO@";
   }:"@RO@@NR@";

   ALARM Rte_Al_TE_StartApp_StartApp_Cyclic500ms {
      COUNTER = SystemTimer;
      ACTION = SETEVENT
      {
         TASK = Default_Appl_Task;
         EVENT = Rte_Ev_Run_StartApp_StartApp_Cyclic500ms;
      }:"@ROC@";
      AUTOSTART = FALSE:"@RO@";
   }:"@RO@@NR@";

   TASK Default_BSW_ASync_Task {
      ACTIVATION = 1:"@RO@";
      PRIORITY = 30:"@RO@";
      SCHEDULE = NON:"@RO@";
// TIMING_PROTECTION = FALSE|TRUE; (AUTOSAR OS only)
      AUTOSTART = FALSE:"@RO@";
   }:"@RO@@NR@";

   ALARM Rte_Al_TE2_Default_BSW_ASync_Task_0_10ms {
      COUNTER = SystemTimer;
      ACTION = ACTIVATETASK
      {
         TASK = Default_BSW_ASync_Task;
      }:"@ROC@";
      AUTOSTART = FALSE:"@RO@";
   }:"@RO@@NR@";

   EVENT Rte_Ev_Run_StartApp_StartApp_Cyclic1ms {
      MASK = AUTO;
   }:"@ROC@@NR@";

   EVENT Rte_Ev_Run_StartApp_StartApp_Cyclic500ms {
      MASK = AUTO;
   }:"@ROC@@NR@";
