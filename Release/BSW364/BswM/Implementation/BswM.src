; ..\BSW364\BswM\Implementation\BswM.c	   796      if (priorityQueueIdx < BswM_GetSizeOfActionListPriorityQueue(partitionIdx)) /*lint -e{661, 662} */
; ..\BSW364\BswM\Implementation\BswM.c	   797      {
