; ..\BSW364\BswM\Implementation\BswM.c	   801        BswM_RemoveIdxFromQueue(priorityQueueIdx, partitionIdx); /*lint -e{661, 662} */
; ..\BSW364\BswM\Implementation\BswM.c	   802      }
; ..\BSW364\BswM\Implementation\BswM.c	   803    }
