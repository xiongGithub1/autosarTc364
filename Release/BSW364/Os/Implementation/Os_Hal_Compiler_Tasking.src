; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Tasking.c	    97  /*! \brief         branch island for all exception vectors without user function (unhandled exception)
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Tasking.c	    98   *                 it switches the stack and calls Os_Hal_UnhandledExc
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Tasking.c	    99   *                 the parameter passed to Os_Hal_UnhandledExc are
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Tasking.c	   100   *                    D4: exception class and TIN (already prepared by exception vector handler)
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Tasking.c	   101   *                    D5: current PCXI value
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Tasking.c	   102   *                    A4: causing address (potential return address)
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Tasking.c	   103   *                    D6: current Stack memory region lower
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Tasking.c	   104   *                    D7: current Stack memory region upper
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Tasking.c	   105   *  \context      EXCEPTION VECTOR
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Tasking.c	   106   *  \reentrant    FALSE
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Tasking.c	   107   *  \synchronous  TRUE
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Tasking.c	   108   *  \pre          -
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Tasking.c	   109   **********************************************************************************************************************/
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Tasking.c	   110  OS_FUNC_ATTRIBUTE_DECLARATION(void, OS_CODE, OS_HAL_NOINLINE, Os_Hal_UnhandledExceptionHandler, (void));
; ..\BSW364\Os\Implementation\Os_Hal_Compiler_Tasking.c	   111  OS_FUNC_ATTRIBUTE_DEFINITION(void, OS_CODE, OS_HAL_NOINLINE, Os_Hal_UnhandledExceptionHandler, (void))
; Function Os_Hal_UnhandledExceptionHandler
