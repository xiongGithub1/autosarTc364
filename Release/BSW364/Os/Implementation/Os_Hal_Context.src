	ld.w	d15,[a5]

; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   777    Os_Hal_Mta11(Context->Lr);      (inlined)
	
	mov.a  a11, d15
	

; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   778    
