; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   789    Os_Hal_ContextIntGo();
	mfcr	d15,#65028
	insert	d15,d15,#0,#7,#1

; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   789    Os_Hal_ContextIntGo();      (inlined)
	mtcr  #0xFE04, d15
	isync

; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   789    Os_Hal_ContextIntGo();      (inlined)
	rfe

; ..\BSW364\Os\Implementation\Os_Hal_Context.c	   147  
; ..\BSW364\Os\Implementation\Os_Hal_Context.c	   148    /* #40 Set the next thread entry */
; ..\BSW364\Os\Implementation\Os_Hal_Context.c	   149    Os_Hal_ContextIntRestore(Next);                                                                                       /* SBSW_OS_HAL_FC_CALLER */
; ..\BSW364\Os\Implementation\Os_Hal_Context.c	   150  }
	ret
	
