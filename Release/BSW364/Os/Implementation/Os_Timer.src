	ld.w	d15,[a15]24
	mov.a	a2,d15
	ld.w	d15,[a15]28
	ld.w	d0,[a2]
	and	d0,d15
	ld.w	d15,[a15]32
	or	d0,d15
	st.w	[a2],d0

