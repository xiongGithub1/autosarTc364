	ld.w	d15,[a15]28

; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   782    Os_Hal_Mta4(Context->A4);      (inlined)
	
	mov.a  a4, d15
	

; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   783  
; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   784    /* #50 Restore the PCXI register. */
; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   785    Os_Hal_Mtcr(OS_HAL_PCXI_OFFSET, Context->PreviousContextInfo);
	ld.w	d15,[a15]8

; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   785    Os_Hal_Mtcr(OS_HAL_PCXI_OFFSET, Context->PreviousContextInfo);      (inlined)
	mtcr  #0xFE00, d15

; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   786    Os_Hal_Isync();
	isync

; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   787  
; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   788    /* #60 Go the next thread. */
; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   789    Os_Hal_ContextIntGo();
	mfcr	d15,#65028
	insert	d15,d15,#0,#7,#1

; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   789    Os_Hal_ContextIntGo();      (inlined)
	mtcr  #0xFE04, d15
	isync

; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   789    Os_Hal_ContextIntGo();      (inlined)
	rfe

