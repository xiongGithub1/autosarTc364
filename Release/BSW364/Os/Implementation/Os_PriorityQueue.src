; ..\BSW364\Os\Implementation\Os_PriorityQueue.c	   439  (
; ..\BSW364\Os\Implementation\Os_PriorityQueue.c	   440    P2CONST(Os_PriorityQueueConfigType, AUTOMATIC, OS_CONST) PriorityQueue,
; ..\BSW364\Os\Implementation\Os_PriorityQueue.c	   441    P2CONST(Os_JobConfigType, TYPEDEF, AUTOMATIC) Data
; ..\BSW364\Os\Implementation\Os_PriorityQueue.c	   442  )
; ..\BSW364\Os\Implementation\Os_PriorityQueue.c	   443  {
; ..\BSW364\Os\Implementation\Os_PriorityQueue.c	   444    /* #10  Assert that the queue has still capacity */
; ..\BSW364\Os\Implementation\Os_PriorityQueue.c	   445    Os_Assert((Os_StdReturnType)(PriorityQueue->Dyn->QueueUsage < PriorityQueue->QueueSize));                             /* PRQA S 4304 */ /* MD_Os_C90BooleanCompatibility */
; ..\BSW364\Os\Implementation\Os_PriorityQueue.c	   446  
; ..\BSW364\Os\Implementation\Os_PriorityQueue.c	   447    /* #20  Append the element after the last used node. */
; ..\BSW364\Os\Implementation\Os_PriorityQueue.c	   448    PriorityQueue->Queue[PriorityQueue->Dyn->QueueUsage].Data = Data;                                                     /* SBSW_OS_PQ_DATA_INDEX_001 */
	ld.a	a2,[a4]4
	ld.a	a15,[a4]
	ld.hu	d15,[a2]0
	addsc.a	a15,a15,d15,#2
	st.a	[a15],a5

; ..\BSW364\Os\Implementation\Os_PriorityQueue.c	   449  
; ..\BSW364\Os\Implementation\Os_PriorityQueue.c	   450    /* #30  Increment the queueUsage counter. */
; ..\BSW364\Os\Implementation\Os_PriorityQueue.c	   451    PriorityQueue->Dyn->QueueUsage++;                                                                                     /* SBSW_OS_PQ_PRIORITYQUEUEGETDYN_001 */
	ld.a	a15,[a4]4
	ld.hu	d15,[a15]0
	add	d15,#1
	st.h	[a15],d15

; ..\BSW364\Os\Implementation\Os_PriorityQueue.c	   452  
; ..\BSW364\Os\Implementation\Os_PriorityQueue.c	   453    /* #40  Reorder the binary tree by calling Os_PriorityQueueHeapUp. */
; ..\BSW364\Os\Implementation\Os_PriorityQueue.c	   454    (void)Os_PriorityQueueHeapUp(PriorityQueue, (PriorityQueue->Dyn->QueueUsage - (Os_PriorityQueueNodeIdxType) 1u ));    /* SBSW_OS_FC_PRECONDITION */
	ld.a	a15,[a4]4
	ld.hu	d15,[a15]0
	add	d15,#-1
	extr.u	d15,d15,#0,#16

; ..\BSW364\Os\Implementation\Os_PriorityQueue.c	   282    while(current > OS_PRIORITYQUEUE_ROOT_IDX)      (inlined)
	jeq	d15,#0,.L2
.L3:
	add	d0,d15,#-1
	ld.a	a2,[a4]
	extr.u	d0,d0,#1,#16
	addsc.a	a15,a2,d15,#2
	addsc.a	a2,a2,d0,#2
	ld.a	a5,[a15]
	ld.a	a6,[a2]

