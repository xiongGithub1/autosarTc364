	st.a	[a2],a4
	mov	d4,#1
	ld.a	a2,[a6]
	addsc.a	a15,a2,d5,#2
	mov	d5,d6
	st.a	[a15],a7
	sh	d6,#1
	add	d6,#1
	extr.u	d6,d6,#0,#16

