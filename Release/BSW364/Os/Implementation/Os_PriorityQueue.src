; ..\BSW364\Os\Implementation\Os_PriorityQueue.c	   425  
; ..\BSW364\Os\Implementation\Os_PriorityQueue.c	   426  
; ..\BSW364\Os\Implementation\Os_PriorityQueue.c	   427  /***********************************************************************************************************************
; ..\BSW364\Os\Implementation\Os_PriorityQueue.c	   428   *  Os_PriorityQueueInsert()
; ..\BSW364\Os\Implementation\Os_PriorityQueue.c	   429   **********************************************************************************************************************/
; ..\BSW364\Os\Implementation\Os_PriorityQueue.c	   430  /*!
