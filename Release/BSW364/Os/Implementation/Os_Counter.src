	sub	d0,d1

; ..\BSW364\Os\Implementation\Os_Counter.h	   245  
; ..\BSW364\Os\Implementation\Os_Counter.h	   246      /* If the left job is less than or equal to MaxDifferentialValue ticks ahead of the right job,
