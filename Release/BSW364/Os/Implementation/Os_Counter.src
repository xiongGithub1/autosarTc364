; Function Os_CounterGetValue
Os_CounterGetValue:	.type	func
	mov.aa	a12,a4
	mov	d15,#20
	ld.bu	d0,[a12]32
	sub.a	a10,#8
	jeq	d15,d0,.L2
	mov	d15,#39
	jeq	d15,d0,.L3
	mov	d15,#67
	jeq	d15,d0,.L4
	mov	d15,#75
	jeq	d15,d0,.L5
	call	Os_ErrKernelPanic

; ..\BSW364\Os\Implementation\Os_Counter.c	   513        Os_ErrKernelPanic();      (inlined)
	j	.L9

