; ..\BSW364\Os\Implementation\Os_Hal_Core.c	   383                   initialized previously by calling Os_Hal_ContextInit in the core code.
; ..\BSW364\Os\Implementation\Os_Hal_Core.c	   384   \COUNTERMEASURE \N No measure is required, because its validity is ensured by code review.
; ..\BSW364\Os\Implementation\Os_Hal_Core.c	   385  
