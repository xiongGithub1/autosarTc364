; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   673  
; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   674    /* #10 Disable all interrupts */
; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   675    Os_Hal_Disable();
	disable

; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   676  
; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   677    /* #20 Create a new CSA entry (lower context), which is a reserved context and is only used when ISRs
; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   678     *     terminate or tasks terminate without calling TerminateTask */
; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   679    Os_Hal_Mtcr(OS_HAL_PCXI_OFFSET, 0x00000000uL);
	mov	d15,#0

; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   679    Os_Hal_Mtcr(OS_HAL_PCXI_OFFSET, 0x00000000uL);      (inlined)
	mtcr  #0xFE00, d15

; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   680    Os_Hal_Isync();
	isync

; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   681    Os_Hal_Svlcx();
	svlcx

; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   682    Os_Hal_Dsync();
	dsync

; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   683  
; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   684    /* #30 Adapt the created CSA entry based on the thread configuration */
; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   685    PCXIRaw = Os_Hal_Mfcr(OS_HAL_PCXI_OFFSET);
	mfcr	d5,#65024

; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   686    PCXIAddr = Os_Hal_GetCsaAddress(PCXIRaw);
	and	d3,d5
	sh	d1,d3,#12
	insert	d15,d5,#0,#16,#16
	sh	d15,#6
	or	d1,d15

; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   687  
; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   688    /* #40 Initialize the program status word */
; ..\BSW364\Os\Implementation\Os_Hal_Context.h	   689    *(uint32*)(PCXIAddr + OS_HAL_CSA_PSW_OFFSET) = CurrentConfig->ProgramStatus;                                          /* PRQA S 0306 */ /* MD_Os_Hal_Rule11.4_0306 */ /* SBSW_OS_HAL_PWA_PCXI */
	add	d15,d1,#4
	mov.a	a2,d15
	ld.w	d15,[a15]8
	st.w	[a2],d15

