EcuM_GetShiftCount:	.type	func

; ..\BSW364\EcuM\Implementation\EcuM.c	   819  {
; ..\BSW364\EcuM\Implementation\EcuM.c	   820    /* ----- Local Variables ---------------------------------------------- */
; ..\BSW364\EcuM\Implementation\EcuM.c	   821    uint8 retval = 0;
	mov	d2,#0

; ..\BSW364\EcuM\Implementation\EcuM.c	   822    EcuM_WakeupSourceType xlocal = x;
; ..\BSW364\EcuM\Implementation\EcuM.c	   823  
