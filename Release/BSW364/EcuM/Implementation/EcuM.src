; ..\BSW364\EcuM\Implementation\EcuM.c	   825    xlocal = xlocal - (EcuM_WakeupSourceType) 1u;
; ..\BSW364\EcuM\Implementation\EcuM.c	   826  
; ..\BSW364\EcuM\Implementation\EcuM.c	   827    /* #30 Shift the passed parameter in single steps till the LSB of the passed parameter is set (1). The iteration steps
; ..\BSW364\EcuM\Implementation\EcuM.c	   828     * represent the wanted shiftcount. */
; ..\BSW364\EcuM\Implementation\EcuM.c	   829    while ((xlocal & 1u) != 0u)
	add	d4,#-1
	j	.L2
.L3:

; ..\BSW364\EcuM\Implementation\EcuM.c	   830    {
; ..\BSW364\EcuM\Implementation\EcuM.c	   831      retval++;
	add	d2,#1
	extr.u	d2,d2,#0,#8

; ..\BSW364\EcuM\Implementation\EcuM.c	   832      /* Right shift with unsigned value is handled as a logical shift in ISO C99 - 0 is inserted as MSB. */
; ..\BSW364\EcuM\Implementation\EcuM.c	   833      xlocal >>= 1u;
	sh	d4,#-1
.L2:
	jnz.t	d4:0,.L3

