; ..\BSW364\NvM\Implementation\NvM_Qry.c	   412  /*!
; ..\BSW364\NvM\Implementation\NvM_Qry.c	   413   * \brief Checks whether the pending background repair redundant blocks job shall be suspended (non-Destructively) or not.
; ..\BSW364\NvM\Implementation\NvM_Qry.c	   414   * \details Since the redundant block repairing is a background job, it can be suspended in a non-destructive way 
; ..\BSW364\NvM\Implementation\NvM_Qry.c	   415   *          by all possible jobs - single or multi block. This query checks whether there is a normal priority job,
; ..\BSW364\NvM\Implementation\NvM_Qry.c	   416   *          or multi block job (ReadAll or WriteAll). It does not care about the high priority jobs - NvM handles this itself.
; ..\BSW364\NvM\Implementation\NvM_Qry.c	   417   * \return FALSE 
; ..\BSW364\NvM\Implementation\NvM_Qry.c	   418   * \return TRUE 
; ..\BSW364\NvM\Implementation\NvM_Qry.c	   419   * \context TASK
; ..\BSW364\NvM\Implementation\NvM_Qry.c	   420   * \reentrant FALSE
; ..\BSW364\NvM\Implementation\NvM_Qry.c	   421   * \synchronous TRUE
; ..\BSW364\NvM\Implementation\NvM_Qry.c	   422   * \config Repair Redundant Blocks Api is enabled
