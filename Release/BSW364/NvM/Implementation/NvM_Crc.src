; ..\BSW364\NvM\Implementation\NvM_Crc.c	  1056    return (boolean)((Crc1[0] == Crc2[0]) && (Crc1[1] == Crc2[1]));
	ld.bu	d15,[a4]
	ld.bu	d0,[a5]
	mov	d2,#0
	jne	d15,d0,.L32
	ld.bu	d15,[a4]1
	ld.bu	d0,[a5]1
	eq	d15,d15,d0
	cmov	d2,d15,#1
.L32:

; ..\BSW364\NvM\Implementation\NvM_Crc.c	  1057  }
	ret
	
