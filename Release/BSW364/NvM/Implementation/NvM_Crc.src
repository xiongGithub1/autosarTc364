; Function NvM_Crc_Crc16_Compare
NvM_Crc_Crc16_Compare:	.type	func

; ..\BSW364\NvM\Implementation\NvM_Crc.c	  1053      NvM_CrcBufferConstPtrType Crc1,
; ..\BSW364\NvM\Implementation\NvM_Crc.c	  1054      NvM_CrcValueRefType Crc2)
