; ..\Appl\GenData\NvM_Cfg.c	   382  #include "NvM_MemMap.h"
; ..\Appl\GenData\NvM_Cfg.c	   383  
; ..\Appl\GenData\NvM_Cfg.c	   384  /* PRQA L:MemMap */
; ..\Appl\GenData\NvM_Cfg.c	   385  
; ..\Appl\GenData\NvM_Cfg.c	   386  /* Justification for module specific MISRA deviations:
; ..\Appl\GenData\NvM_Cfg.c	   387  
; ..\Appl\GenData\NvM_Cfg.c	   388  MD_NvM_Cfg_2.4
; ..\Appl\GenData\NvM_Cfg.c	   389  Reason: NvM provides compile time block length checks via structures with bitfields with positive or negative length -
; ..\Appl\GenData\NvM_Cfg.c	   390          the negative length lead to compiler errors. It is possible to use == or even >= check, if only one is used,
; ..\Appl\GenData\NvM_Cfg.c	   391          the other one will never be used. The macros are always available. The created structures will never be used by NvM.
; ..\Appl\GenData\NvM_Cfg.c	   392  Risk: No risk.
; ..\Appl\GenData\NvM_Cfg.c	   393  Prevention: No prevention.
; ..\Appl\GenData\NvM_Cfg.c	   394  
; ..\Appl\GenData\NvM_Cfg.c	   395  MD_NvM_Cfg_2.7:
; ..\Appl\GenData\NvM_Cfg.c	   396  Reason: The function NvM_MultiBlockCbk gets all needed parameters to invoke the BSWM and multi block job end callback.
; ..\Appl\GenData\NvM_Cfg.c	   397          If both are disabled, the function is empty and does nothing - the passed parameters remain unused.
; ..\Appl\GenData\NvM_Cfg.c	   398  Risk: No risk.
; ..\Appl\GenData\NvM_Cfg.c	   399  Prevention: No prevention.
; ..\Appl\GenData\NvM_Cfg.c	   400  
; ..\Appl\GenData\NvM_Cfg.c	   401  MD_NvM_Cfg_8.9_InternalBuffer:
; ..\Appl\GenData\NvM_Cfg.c	   402  Reason: NvM uses an internal buffer for explicit synchronization, in internal CRC buffer use case and for repair redundant blocks.
; ..\Appl\GenData\NvM_Cfg.c	   403          Depending on configuration all, one or even none of the uses is enabled - therefore sometimes the internal buffer is
; ..\Appl\GenData\NvM_Cfg.c	   404          used only once.
; ..\Appl\GenData\NvM_Cfg.c	   405  Risk: No risk.
; ..\Appl\GenData\NvM_Cfg.c	   406  Prevention: No prevention.
; ..\Appl\GenData\NvM_Cfg.c	   407  
; ..\Appl\GenData\NvM_Cfg.c	   408  MD_NvM_Cfg_8.11:
; ..\Appl\GenData\NvM_Cfg.c	   409  Reason: Array of unknown size is used in order to reduce dependencies.
; ..\Appl\GenData\NvM_Cfg.c	   410  Risk: In case the array size shall be determined it would be incorrect.
; ..\Appl\GenData\NvM_Cfg.c	   411  Prevention: No prevention.
; ..\Appl\GenData\NvM_Cfg.c	   412  
; ..\Appl\GenData\NvM_Cfg.c	   413  MD_NvM_Cfg_14.3:
; ..\Appl\GenData\NvM_Cfg.c	   414  Reason: NvM provides compile time block length checks via bitfields with positive or negative length - the negative length
; ..\Appl\GenData\NvM_Cfg.c	   415          lead to compiler errors. With valid configuration (all block length are configured correctly), all checks are false.
; ..\Appl\GenData\NvM_Cfg.c	   416  Risk: No risk.
; ..\Appl\GenData\NvM_Cfg.c	   417  Prevention: No prevention. If needed the compile time checks can be disabled via configuration.
; ..\Appl\GenData\NvM_Cfg.c	   418  
; ..\Appl\GenData\NvM_Cfg.c	   419   */
; ..\Appl\GenData\NvM_Cfg.c	   420  
